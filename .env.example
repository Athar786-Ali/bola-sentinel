# Environment configuration for bola-sentinel
#
# Copy this file to .env and fill in your values.
# The .env file is git-ignored.  Do NOT commit real credentials.
#
# Only Ollama (local LLM) settings are used — no paid API keys.

# ── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Directory overrides (optional, defaults shown) ────────────────────────
# RESULTS_DIR=results
# LOGS_DIR=logs
# DATASETS_DIR=datasets
